appname=crosspaste
version=0.1.5
display_name=跨贴
desc=网页端剪切板支持：文本、图片、视频、音频、文件统一收纳，分组、标签、收藏，自动识别文本类型（Markdown 可直接渲染，含表格、任务列表与 Mermaid 图表，通篇一张图的条目可全屏查看，拖动平移、滚轮或双指缩放至 50%–400%），并按扩展名匹配 147 种文件类型图标，图片在列表与详情页均可点开大图缩放查看；对外分享支持访问与下载统计（访问按访客去重）与访问日志追溯；接入 fnOS 统一网关，桌面入口免记端口并随系统登录态访问；支持安装向导自定义服务端口与设置页访问密码，同时保留独立端口供局域网直连。
source=thirdparty
platform=all
maintainer=YUNXI
maintainer_url=https://github.com/YUNXI-fi/Crosspaste
distributor=YUNXI
distributor_url=https://github.com/YUNXI-fi/Crosspaste
os_min_version=1.2.0

# 使用开放平台 JS SDK
micro_app=true

# 常驻服务（有 start/stop/status 控制）
ctl_stop=true

# 独立端口访问（TCP）；桌面入口见 app/ui/config
service_port=28531
checkport=true

# 桌面入口
desktop_uidir=ui
desktop_applaunchname=crosspaste.main

# 升级说明
changelog=v0.1.5：Markdown 与图片查看支持缩放——通篇一张图的条目可在预览面板全屏打开，拖动平移、滚轮或双指捏合缩放（以光标为锚点，范围 50%–400%，点百分比即复位，Esc 退出）；列表点图弹出的大图查看可缩放与拖动，松手不再被误判为点击而关闭，切换图片自动回到 100%；详情页内容图片居中显示并可点开同一套大图查看；加密分组在侧栏与「切换分组」下拉里显示解锁状态图标（敞口锁梁=已解锁，闭合锁梁=未解锁）。解锁凭证（分组密码 / 设置页密码 / 整站访问密码）改为落库保存，重启与升级后不必重新解锁（升级到本版需重新解锁一次，48 小时有效期不变）。修复单行标题/列表/引用等结构文本不被识别为 Markdown、CRLF 换行的表格判不出 Markdown、英文散文被误判为代码、修改内容后类型不随之更新、带横线的手机号不被识别、Mermaid 图表节点文字丢失、灯箱缩放中心偏离鼠标位置，以及移动到已解锁的加密分组却被提示「分组未解锁」。
