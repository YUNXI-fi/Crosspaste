appname=crosspaste
version=0.1.3
display_name=跨贴
desc=网页端剪切板支持：文本、图片、视频、音频、文件统一收纳，分组、标签、收藏，自动识别文本类型，并按扩展名匹配 147 种文件类型图标；对外分享支持访问与下载统计（访问按访客去重）与访问日志追溯；接入 fnOS 统一网关，桌面入口免记端口并随系统登录态访问；支持安装向导自定义服务端口与设置页访问密码，同时保留独立端口供局域网直连。
source=thirdparty
platform=all
maintainer=YUNXI
maintainer_url=https://github.com/YUNXI-fi/Crosspaste
distributor=YUNXI
distributor_url=https://github.com/YUNXI-fi/Crosspaste
os_min_version=1.2.0

# 使用开放平台 JS SDK
micro_app=true

# 常驻服务（有 start/stop/status 控制）
ctl_stop=true

# 独立端口访问（TCP）；桌面入口见 app/ui/config
service_port=28531
checkport=true

# 桌面入口
desktop_uidir=ui
desktop_applaunchname=crosspaste.main

# 升级说明
changelog=v0.1.3：分享新增访问与下载统计（访问按访客 24 小时去重、下载不计页面内预览与播放）与访问日志（含来源 IP 与时间，可在分享管理里按分享查看）；品牌 logo 改为跟随主题的内联图标并同步更新 favicon 与应用图标；设置页标题上移顶栏，移动端补充返回首页入口与进入箭头。
