appname=crosspaste
version=0.1.4
display_name=跨贴
desc=网页端剪切板支持：文本、图片、视频、音频、文件统一收纳，分组、标签、收藏，自动识别文本类型（Markdown 可直接渲染，含表格、任务列表与 Mermaid 图表），并按扩展名匹配 147 种文件类型图标；对外分享支持访问与下载统计（访问按访客去重）与访问日志追溯；接入 fnOS 统一网关，桌面入口免记端口并随系统登录态访问；支持安装向导自定义服务端口与设置页访问密码，同时保留独立端口供局域网直连。
source=thirdparty
platform=all
maintainer=YUNXI
maintainer_url=https://github.com/YUNXI-fi/Crosspaste
distributor=YUNXI
distributor_url=https://github.com/YUNXI-fi/Crosspaste
os_min_version=1.2.0

# 使用开放平台 JS SDK
micro_app=true

# 常驻服务（有 start/stop/status 控制）
ctl_stop=true

# 独立端口访问（TCP）；桌面入口见 app/ui/config
service_port=28531
checkport=true

# 桌面入口
desktop_uidir=ui
desktop_applaunchname=crosspaste.main

# 升级说明
changelog=v0.1.4：Markdown 支持 Mermaid 图表渲染（时序图、流程图、状态图、时间线、甘特图等，跟随深浅主题自动重绘，图表引擎按需加载不进首屏）；Markdown 的预览/源码切换改为「预览 / Markdown」滑动开关，首页卡片与详情页一致，详情页原四按钮分段控件移除；标题不再显示文件后缀；修复改过标题的条目下载时丢扩展名，以及中文标题的下载名兜底乱码。
