#!/bin/sh
# 卸载清理后执行（幂等）：清运行痕迹（pid/socket）；用户数据按卸载向导
# wizard_purge_data 的选择决定是否删除，默认保留。
set -u

APP=crosspaste
APPDEST="${TRIM_APPDEST:-/var/apps/crosspaste/target}"
PKGVAR="${TRIM_PKGVAR:-/var/apps/crosspaste/var}"
BINDIR="$APPDEST/server/bin"

PIDFILE="$PKGVAR/crosspaste.pid"

# pid_is_ours 判断 pid 是否真的是本应用：遗留的 pid 可能已被系统复用给别的进程，
# 只看 kill -0 会误杀无关进程。比对 /proc/<pid>/cmdline 的首项（可执行文件路径）。
pid_is_ours() {
  [ -r "/proc/$1/cmdline" ] || return 1
  first=$(tr '\0' '\n' < "/proc/$1/cmdline" 2>/dev/null | head -n 1)
  case "$first" in
    "$BINDIR"/crosspaste_linux_amd64|"$BINDIR"/crosspaste_linux_arm64) return 0 ;;
  esac
  return 1
}

# 兜底停掉残留进程（正常卸载前系统已 stop，此处防漏网）
if [ -s "$PIDFILE" ]; then
  pid=$(cat "$PIDFILE" 2>/dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && pid_is_ours "$pid"; then
    kill "$pid" 2>/dev/null
    i=0
    while [ $i -lt 30 ]; do
      kill -0 "$pid" 2>/dev/null || break
      i=$((i+1)); sleep 0.5
    done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
  fi
fi

rm -f "$PIDFILE"

# 卸载向导：勾选"删除应用数据"时清空数据目录，默认保留
if [ "${wizard_purge_data:-false}" = "true" ]; then
  rm -rf "$PKGVAR"
  echo "$APP: purged user data at $PKGVAR"
else
  echo "$APP: uninstalled; user data in $PKGVAR left untouched"
fi
exit 0
